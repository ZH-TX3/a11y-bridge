<?xml version="1.0" encoding="utf-8"?>
<!-- The event types only matter for the settle counter (a reused read). Reading itself is
     on-demand through getWindows()/rootInActiveWindow. isAccessibilityTool=false: this is not a
     tool for a blind user, and claiming otherwise is both dishonest and a Play policy issue. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewTextChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
